{
  "name": "open-playgrounds",
  "version": "0.1.0",
  "description": "A local-first personal planner (worlds, projects, tasks, calendar, focus timer) that you and your AI tools share through one JSON file and a small CLI.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "browser/main.mjs",
  "productName": "Playgrounds",
  "author": "Playgrounds contributors",
  "bin": {
    "pg": "scripts/pg.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite --port 5340 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && node server/serve.mjs",
    "pg": "node scripts/pg.mjs",
    "test": "vitest run",
    "desktop": "electron .",
    "dist:mac": "npm run build && node build/dist.mjs mac",
    "dist:win": "npm run build && node build/dist.mjs win"
  },
  "dependencies": {
    "puppeteer-core": "^23.11.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
