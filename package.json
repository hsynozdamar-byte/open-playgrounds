{
  "name": "open-playgrounds",
  "version": "0.1.0",
  "description": "A local-first personal planner (worlds, projects, tasks, calendar, focus timer) that you and your AI tools share through one JSON file and a small CLI.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "pg": "scripts/pg.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite --port 5340 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && node server/app.mjs",
    "pg": "node scripts/pg.mjs",
    "test": "vitest run",
    "desktop": "sh desktop/build.sh --install"
  },
  "dependencies": {
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.1.1"
  }
}
